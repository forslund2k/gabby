# Copy to .env (or export these) before running Gabby in production mode.

# Flask session signing key — set a long random value in production.
SECRET_KEY=change-me-to-a-long-random-string

# --- Chat brain (LLM) ---
# Leave GABBY_API_KEY empty to run in DEMO MODE (keyword-based replies, no cost).
# Set it to use a real OpenAI-compatible chat completions API.
GABBY_API_KEY=
GABBY_API_BASE=https://api.openai.com/v1
GABBY_MODEL=gpt-4o-mini
# Embedding model for semantic knowledge search (tiny cost: ~$0.02 per 1M tokens).
GABBY_EMBED_MODEL=text-embedding-3-small
